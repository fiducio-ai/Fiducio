# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Build artifacts
build/
dist/
*.egg-info/
.eggs/
wheels/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# MkDocs build output
site/

# Virtual environments
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Saved calibrators and local data (never commit binaries/outputs)
*.pt
*.pth
outputs/
data/
# Persistence fixtures written by the published 0.1.0 wheel (tests)
!tests/fixtures/v0_1_0/*.pt
